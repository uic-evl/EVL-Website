{% comment %}
  News as a responsive card grid.
  - With include.limit (home page): the N most recent items in one grid.
  - Without a limit (/news/): grouped by year with tag filters and a search box.
  Each card is rendered by the news_card.liquid include so both views match.
{% endcomment %}


<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}

    {% if include.limit and include.limit != true %}
      {% assign news = news | slice: 0, include.limit %}
      <div class="news-grid row row-cols-1 row-cols-sm-2 row-cols-md-3">
        {% for item in news %}
          {% include news_card.liquid item=item %}
        {% endfor %}
      </div>
    {% else %}
      <div class="row">
        <!-- Sticky left menu -->
        <div class="col-md-2 d-none d-md-block">
          <div class="sticky-top" style="top: 100px;">
            <ul class="list-unstyled">
              <li><a data-tag="all" class="filter-link news_selected">All</a></li>
              <li><a data-tag="event" class="filter-link">Events</a></li>
              <li><a data-tag="paper" class="filter-link">Papers</a></li>
              <li><a data-tag="research" class="filter-link">Research</a></li>
              <li><a data-tag="art" class="filter-link">Art</a></li>
            </ul>
          </div>
        </div>

        <!-- Main content -->
        <div class="col-md-10">
          <!-- Search Box -->
          <div class="row mb-4">
            <div class="col-12">
              <div style="position: relative; max-width: 350px;">
                <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--global-text-color-light);"></i>
                <input type="text" id="news-search" class="search" placeholder="Search news..." style="width: 100%;">
              </div>
            </div>
          </div>

          {% assign grouped_by_year = news | group_by_exp: "item", "item.date | date: '%Y'" %}
          {% for year_group in grouped_by_year %}
            <section class="news-year year-row" data-year="{{ year_group.name }}">
              <h2 class="year-divider">{{ year_group.name }}</h2>
              <div class="news-grid row row-cols-1 row-cols-sm-2 row-cols-lg-3">
                {% for item in year_group.items %}
                  {% include news_card.liquid item=item %}
                {% endfor %}
              </div>
            </section>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>

{% unless include.limit and include.limit != true %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('news-search');
    const buttons = document.querySelectorAll('.filter-link');
    const newsItems = document.querySelectorAll('.news-item');
    const yearRows = document.querySelectorAll('.year-row');

    function updateFilters() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const activeBtn = document.querySelector('.filter-link.news_selected');
      const activeTag = activeBtn ? activeBtn.getAttribute('data-tag') : 'all';
      const visibleYears = new Set();

      newsItems.forEach(item => {
        const itemTags = (item.dataset.tags || '').split(' ');
        const authors = (item.dataset.authors || '').toLowerCase();
        const cats = (item.dataset.categories || '').split(',').map(s => s.trim().toLowerCase());
        const itemTitle = (item.dataset.title || '').toLowerCase();
        const itemYear = item.dataset.year;

        const matchesTag = (activeTag === 'all' || itemTags.includes(activeTag));
        const matchesQuery = (
          query === ''
          || cats.includes(query)
          || itemTitle.includes(query)
          || (itemYear && itemYear.includes(query))
          || authors.includes(query)
        );

        if (matchesTag && matchesQuery) {
          item.style.display = '';
          if (itemYear) visibleYears.add(itemYear);
        } else {
          item.style.display = 'none';
        }
      });

      yearRows.forEach(row => {
        row.style.display = visibleYears.has(row.dataset.year) ? '' : 'none';
      });
    }

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        buttons.forEach(btn => btn.classList.remove('news_selected'));
        button.classList.add('news_selected');
        updateFilters();
      });
    });

    if (searchInput) {
      let timer = null;
      searchInput.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(updateFilters, 150);
      });
      searchInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') updateFilters();
      });
    }

    updateFilters();
  });
</script>
{% endunless %}
