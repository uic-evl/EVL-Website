# Active Directory. The service binds as the user who is logging in; no service account is needed.
AD_HOST=ad.uic.edu
AD_PORT=389
AD_USE_TLS=1
# DNS domain (user@domain, simple bind over StartTLS) or NetBIOS name (DOMAIN\user, NTLM bind).
# The DNS form is preferred: no NTLM, so no extra crypto dependency.
AD_DOMAIN=ad.uic.edu
# Where to look up the user's groups, several bases separated by |. Leave empty if you do not restrict by group.
AD_BASEDN=

# Sessions. Generate the secret with: openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=12
COOKIE_NAME=evl_session
COOKIE_SECURE=1

# Where nginx serves the login page (static file from the site's login/ folder).
LOGIN_PAGE=/login/
