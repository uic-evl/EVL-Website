# {{ generated_by }}
# EVL monitor relay: /monitor/data/<id>/<file> -> http://<fqdn>:{{ evl_monitor_port }}/<file>
# Included from the www.evl.uic.edu server block: include snippets/evl-monitor.conf;
location ^~ /monitor/data/ {
    # proxy_pass below uses a variable, so names resolve per request and a host
    # that is down or missing from DNS can never stop nginx from reloading
    resolver {{ evl_monitor_resolver }} valid=30s ipv6=off;
    resolver_timeout 2s;
    access_log off;
{% for h in evl_monitor_live_hosts %}

    location ~ ^/monitor/data/{{ h.id }}/(?<evlmon_file>(?:now|procs|host|spark|usage|services|daily)\.json|(?:history|series)/(?:1h|24h|7d|30d|1y)\.json|healthz)$ {
        limit_except GET { deny all; }
        proxy_pass http://{{ h.fqdn }}:{{ evl_monitor_port }}/$evlmon_file;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_next_upstream off;
        proxy_cache evlmon;
        proxy_cache_key $proxy_host$uri;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 3s;
        proxy_cache_revalidate on;
        add_header Access-Control-Allow-Origin $evlmon_cors always;
        add_header Vary "Origin" always;
        add_header X-Robots-Tag "noindex" always;
        add_header X-Cache $upstream_cache_status always;
    }
{% endfor %}

    return 404;
}
