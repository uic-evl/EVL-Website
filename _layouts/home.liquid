    {
      image: "/images/siggraph2925_cc_ycgh.png-srcw.jpg",
      caption: "VR: A Therapeutic VR Journey for Anxiety Management",
      link: "https://www.evl.uic.edu/news/2025/2025-01-16-2946/"
