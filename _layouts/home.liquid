<!-- Hero: a random photo on each load, cross-fading through the list -->
<header class="evl-hero" id="evl-hero">
  <a id="hero-image-link" class="evl-hero-link" href="/">
    <img id="hero-image" src="" alt="{{ page.subtitle }}" fetchpriority="high" decoding="async" />
    <div class="evl-hero-overlay">
      <h1 class="evl-hero-title">{{ page.subtitle }}</h1>
      <p class="evl-hero-caption"><span id="hero-caption"></span></p>
    </div>
  </a>
</header>

