    },
    {
      image: '/assets/img/homepage/fmiranda_continuum-1400.webp',
      caption: "Prof. Miranda showing Urban Analytics on the Continuum wall",
      link: "https://www.evl.uic.edu/projects/urban-miranda/"
    },
    {
      image: '/assets/img/homepage/gmarai_nihrelease-1400.webp',
      caption: "Prof. Marai with co-investigators in CAVE2",
      link: "https://www.evl.uic.edu/projects/cancer-marai/"
    },
    {
      image: '/assets/img/homepage/IMG_5216-1400.webp',
      caption: "CS+DES class in Continuum space with Prof. Tsoupikova",
      link: "https://cs.uic.edu/undergraduate/majors/cs-design-alt/"
    },
    {
      image: '/assets/img/homepage/tsoupikovadaria-magazine-240805-1400.webp',
      position: "top",
      caption: "Prof. Tsoupikova showing her work in the lobby of 150 North Riverside Plaza",
      link: "https://www.evl.uic.edu/news/2024/2024-11-01-2879/"
    },
    {
      image: '/assets/img/homepage/visit3-1400.webp',
      caption: "Touch wall with SAGE2 in the Continuum space",
      link: "https://www.evl.uic.edu/projects/sage3-renambot/"
    },
    {
      image: '/assets/img/homepage/_LJL2368-Edit-1400.webp',
      caption: "Group visiting the new Arcade space in the CDRLC building",
      link: "https://www.evl.uic.edu/news/2025/2025-07-16-2941/"
    },
    {
      image: '/assets/img/homepage/wall-1400.webp',
      caption: "SAGE2 visualization on the Touch Wall in the Continuum space",
      link: "https://www.evl.uic.edu/projects/sage3-renambot"
    },
    {
      image: "/images/sc25_art.png-srcw.jpg",
      caption: "The Art of HPC Exhibition at Supercomputing25",
      link: "https://www.evl.uic.edu/news/2025/2025-11-16-2994/"
    },
    {
      image: "/images/lmarai-3.jpg-srcw.jpg",
      caption: "Prof. Marai Delivers Keynote at the Visual Analytics in Healthcare",
      link: "https://www.evl.uic.edu/news/2025/2025-11-02-2983/"
    },
    {
      image: "/images/scobeli_komar.png-srcw.jpg",
      caption: "EVL Graduate Students on their paper acceptance to IEEE TVCG",
      link: "https://www.evl.uic.edu/news/2025/2025-11-01-2982/"
    },
    {
      image: "/images/cfloricel_dissertation.jpeg-srcw.jpg",
      caption: "Carla Floricel's PhD Defense",
      link: "https://www.evl.uic.edu/news/2025/2025-10-21-2980/"
    },
    {
      image: "/images/lanpapka.png-srcw.jpg",
      caption: "Researchers Michael Papka and Zhiling Lan Receive New NSF CISE Award",
      link: "https://www.evl.uic.edu/news/2025/2025-10-01-2935/"
    },
    {
      image: "/images/preuss1.jpg-srcw.jpg",
      caption: "VR: The Hidden Costs of Logistics and the Disappearing Wild",
      link: "https://www.evl.uic.edu/news/2025/2025-09-15-2945/"
    },
    {
      image: "/images/fulfillment.png-srcw.jpg",
      caption: "VR: a field guide to the logistical city",
      link: "https://www.evl.uic.edu/news/2025/2025-09-15-2939/"
