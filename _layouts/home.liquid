    {
      image: '/assets/img/homepage/renambot-2024-1400.webp',
      caption: "Luc Renambot Collaborates with Argonne National Laboratory Researchers on Newly Awarded “Scientific Data Management and Visualization to Advance AI for Science“",
      link: "https://www.evl.uic.edu/news/2025/2025-11-21-3001/"
    },
    {
      image: '/images/dtsoupikova_caa2026.png-srcw.jpg',
      position: "top",
      caption: "Design Professor Daria Tsoupikova Presents at CAA 114",
      link: "https://www.evl.uic.edu/news/2026/2026-02-20-3004/"
    },
    {
      image: '/images/awentzel_dissertation-2.png-srcw.jpg',
      caption: "Dr. Andrew Wentzel Receives the UIC 2025 Outstanding Dissertation Award",
      link: "https://www.evl.uic.edu/news/2026/2026-03-31-3009/"
    },
    {
      image: '/assets/img/homepage/coe-winners.jpg',
      caption: "EVL Students Among 2026 COE Award Winners",
      link: "https://www.evl.uic.edu/news/2026/2026-05-04-3017/"
    },
    {
      image: '/assets/img/homepage/dtsoupikova_immerse2026.jpg',
      caption: "Professor Daria Tsoupikova Presents at IMMERSE 2026",
      link: "https://www.evl.uic.edu/news/2026/2026-04-28-3018/"
    }
  ];

  var img = document.getElementById("hero-image");
  var link = document.getElementById("hero-image-link");
  var caption = document.getElementById("hero-caption");
  if (!img || !heroItems.length) return;

  var ROTATE_MS = 9000;
  var FADE_MS = 700;
  var index = Math.floor(Math.random() * heroItems.length);

  function apply(item) {
    img.src = item.image;
    // Optional per-photo crop anchor (CSS object-position), e.g. "top" or "center 30%".
    img.style.objectPosition = item.position || "";
    link.href = item.link;
    caption.textContent = item.caption;
  }

  // First image: set synchronously so it is in the initial paint.
  apply(heroItems[index]);

  // If the current image fails to load (e.g. a missing upload), move on to the next one.
  var errors = 0;
  img.addEventListener("error", function () {
    if (++errors >= heroItems.length) return;
    index = (index + 1) % heroItems.length;
    apply(heroItems[index]);
  });

  var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduceMotion || heroItems.length < 2) return;

  function next() {
    if (document.hidden) return; // don't burn bandwidth in a background tab
    var nextIndex = (index + 1) % heroItems.length;
    var nextItem = heroItems[nextIndex];
    var preload = new Image();
    preload.onload = function () {
      img.classList.add("is-fading");
      setTimeout(function () {
        index = nextIndex;
        apply(nextItem);
        img.classList.remove("is-fading");
      }, FADE_MS);
    };
    preload.onerror = function () {
      index = nextIndex; // skip a broken image without fading
    };
    preload.src = nextItem.image;
  }

  setInterval(next, ROTATE_MS);
})();
</script>

<div class="post">
  <article>
    <div class="evl-intro clearfix">{{ content }}</div>

    {% if page.highlights and page.highlights.size > 0 %}
      <div class="evl-highlights">
        <div class="row row-cols-2 row-cols-md-4">
          {% for h in page.highlights %}
            <div class="col">
              <a class="evl-highlight card evl-card h-100" href="{% if h.link contains '://' %}{{ h.link }}{% else %}{{ h.link | relative_url }}{% endif %}">
                <span class="evl-highlight-label">{{ h.label }}</span>
                <span class="evl-highlight-title">{{ h.title }}</span>
                <p class="evl-highlight-text">{{ h.text }}</p>
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <div class="evl-section-heading">
        <h2><a href="{{ '/news/' | relative_url }}">News</a></h2>
        <a class="evl-view-all" href="{{ '/news/' | relative_url }}">All news &rarr;</a>
      </div>
      {% include news.liquid limit=page.announcements.limit %}
    {% endif %}

    <!-- Recent publications -->
    {% if page.selected_papers %}
      <div class="evl-section-heading">
        <h2><a href="{{ '/publications/' | relative_url }}">Recent Publications</a></h2>
        <a class="evl-view-all" href="{{ '/publications/' | relative_url }}">All publications &rarr;</a>
      </div>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
