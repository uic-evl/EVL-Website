---
layout: page
---
{% comment %} People now; alumni have their own page at /people/alumni/ (_pages/alumni.html) {% endcomment %}
{% assign status_order = "faculty,staff,affiliate,student,visiting,emeritus,friend" | split: "," %}
{% assign display_names = "faculty,staff,affiliates,students,visiting researchers,emeritus,friends" | split: "," %}
{% assign alumni_count = site.data.people | where: "status", "alumni" | size %}

<div class="profiles-page container-fluid">
  <div class="row">

    <!-- Sticky left menu -->
    <div class="col-md-2 d-none d-md-block" style="padding-left:0;">
      <div class="sticky-top" style="top: 100px;">
        <ul class="list-unstyled">
          {% for status in status_order %}
            {% assign people_in_status = site.data.people | where: "status", status %}
            {% if people_in_status.size > 0 %}
              <li><a class="status-link" href="#{{ status }}">{{ display_names[forloop.index0] }}</a></li>
            {% endif %}
          {% endfor %}
          <li class="mt-2"><a class="status-link" href="{{ '/people/alumni/' | relative_url }}">alumni &rarr;</a></li>
        </ul>
      </div>
    </div>

    <!-- Main content -->
    <div class="col-md-10">
      <div class="post">
        <article>
          {% for status in status_order %}
            {% assign people_in_status = site.data.people | where: "status", status | sort: "dirLastName" %}
            {% if people_in_status.size > 0 %}
              <div class="status-section people-status-anchor-target" id="{{ status }}">
                <div class="row">
                  <div class="col-12">
                    <h2 class="people-category">{{ display_names[forloop.index0] }}</h2>
                  </div>
                </div>

                <div class="container px-0">
                  <div class="row pb-4">
                      {% for profile in people_in_status %}
                        <div class="col-4 px-0 py-2">
                          <div class="profile-name">
                            <strong>{{ profile.name }}{% if profile.alumni %} ({{ profile.alumni }}){% endif %}</strong>
                            {% if profile.image and status == "faculty" or profile.image and status == "affiliate" %}
                              {% comment %} Faculty and affiliate headshots: the CSV "image" field names a file in assets/img/faculty/ {% endcomment %}
                              {% assign fac_path = "/assets/img/faculty/" | append: profile.image %}
                              {% assign fac_file = site.static_files | where: "path", fac_path | first %}
                              {% if fac_file %}
                                {% assign fac_base = fac_path | split: "." | pop | join: "." | replace: " ", "%20" %}
                                {% assign fac_src = fac_path | replace: " ", "%20" %}
                                <picture class="profile-thumb-wrap">
                                  <source srcset="{{ fac_base | append: '-480.webp' | relative_url }}" type="image/webp">
                                  <img class="profile-thumb" src="{{ fac_src | relative_url }}" alt="{{ profile.name }}" loading="lazy">
                                </picture>
                              {% endif %}
                            {% endif %}
                          </div>
                          {% comment %} Students show only their current (first) title line; earlier titles stay in the CSV {% endcomment %}
                          {% if profile.dirTitle and status == "student" %}{{ profile.dirTitle | split: "<br>" | first }}<br>
                          {% elsif profile.dirTitle %}{{ profile.dirTitle }}<br>{% endif %}
                          {% if profile.department %}{{ profile.department }}<br>{% endif %}
                          {% include people/links.liquid profile=profile %}
                        </div>
                      {% endfor %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}

          <div class="status-section people-status-anchor-target" id="alumni">
            <div class="row"><div class="col-12"><h2 class="people-category">alumni</h2></div></div>
            <p class="people-alumni-link">
              EVL has {{ alumni_count }} alumni.
              <a href="{{ '/people/alumni/' | relative_url }}">See the alumni timeline and directory &rarr;</a>
            </p>
          </div>
        </article>
      </div>
    </div>
  </div>
</div>
