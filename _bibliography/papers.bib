	title        = {Ultrascale Collaborative Visualization Using a Display-Rich Global Cyberinfrastructure},
	author       = {Jeong, Byungil and Leigh, Jason and Johnson, Andrew and Renambot, Luc and Brown, Maxine and Jagodic, Ratko and Nam, Sungwon and Hur, Hyejung},
